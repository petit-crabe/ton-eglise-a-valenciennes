{
  "$description": "Design tokens of the tonegliseavalenciennes.fr redesign, validated with the home page mockup on 2026-10-25. Format: W3C Design Tokens Community Group 2025.10. Rules for using them: DESIGN.md.",
  "color": {
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2275,
          0.3922,
          0.6667
        ],
        "hex": "#3a64aa"
      },
      "$description": "Brand blue from the logo. Every button (filled, or outlined for secondary actions), links, icons. White text on it: 5.9:1."
    },
    "primary-hover": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1686,
          0.302,
          0.5255
        ],
        "hex": "#2b4d86"
      },
      "$description": "Hover state of primary links and buttons. White text on it: 8.4:1."
    },
    "secondary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0745,
          0.1412,
          0.2314
        ],
        "hex": "#13243b"
      },
      "$description": "Night blue. Headings, hero overlay, footer, date badges, current menu item. On white: 15.6:1."
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.6863,
          0.0
        ],
        "hex": "#ffaf00"
      },
      "$description": "Sun yellow. Accent only: the underline of \"nous\", the play button, quote marks. Never text, never a button."
    },
    "text": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1765,
          0.2314,
          0.3059
        ],
        "hex": "#2d3b4e"
      },
      "$description": "Body text. On white: 11.4:1."
    },
    "text-muted": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3333,
          0.3843,
          0.4588
        ],
        "hex": "#556275"
      },
      "$description": "Labels, dates, captions. On white 6.2:1, on sand 5.6:1, on sky 5.5:1."
    },
    "surface-white": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      },
      "$description": "Cards and sections."
    },
    "surface-sand": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9686,
          0.9529,
          0.9333
        ],
        "hex": "#f7f3ee"
      },
      "$description": "Page background, info cards, department tiles, image placeholders."
    },
    "surface-sky": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9137,
          0.9529,
          0.9843
        ],
        "hex": "#e9f3fb"
      },
      "$description": "Events section, contact card \"Demande de prière\"."
    },
    "surface-sun": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.9451,
          0.8
        ],
        "hex": "#fff1cc"
      },
      "$description": "Bible verse, date tag, contact card \"Nous contacter\"."
    },
    "border": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8941,
          0.9059,
          0.9255
        ],
        "hex": "#e4e7ec"
      },
      "$description": "Hairline around the map."
    }
  },
  "overlay": {
    "hero": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0745,
          0.1412,
          0.2314
        ],
        "hex": "#13243b",
        "alpha": 0.74
      },
      "$description": "Layer over the blurred hero photo; keeps white text at 6.7:1 or more."
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Outfit",
          "system-ui",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Source Sans 3",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Headings font only."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "size": {
      "display": {
        "$type": "dimension",
        "$value": {
          "value": 72,
          "unit": "px"
        },
        "$description": "Hero title, computer."
      },
      "display-mobile": {
        "$type": "dimension",
        "$value": {
          "value": 42,
          "unit": "px"
        },
        "$description": "Hero title, phone."
      },
      "page-title": {
        "$type": "dimension",
        "$value": {
          "value": 56,
          "unit": "px"
        },
        "$description": "Title (h1) in the banner of inner pages, computer."
      },
      "page-title-mobile": {
        "$type": "dimension",
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$description": "Title (h1) in the banner of inner pages, phone."
      },
      "section-title": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Every section title (h2), computer."
      },
      "section-title-mobile": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        },
        "$description": "Every section title (h2), phone."
      },
      "card-title": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "Card titles (h3) and contact card labels."
      },
      "lead": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Welcome paragraph."
      },
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$description": "Body text, computer."
      },
      "body-mobile": {
        "$type": "dimension",
        "$value": {
          "value": 17,
          "unit": "px"
        },
        "$description": "Body text, phone. Never below 16 px for running text."
      },
      "small": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Meta lines, footer."
      },
      "caption": {
        "$type": "dimension",
        "$value": {
          "value": 15,
          "unit": "px"
        },
        "$description": "Dates and labels. The smallest size allowed."
      }
    },
    "line-height": {
      "heading": {
        "$type": "number",
        "$value": 1.1
      },
      "body": {
        "$type": "number",
        "$value": 1.6
      }
    }
  },
  "space": {
    "2xs": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "s": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "m": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "l": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "Buttons, tags, date badges, menu items."
    },
    "card": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "Cards, tiles, photos, map."
    },
    "round": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      },
      "$description": "Only icon circles and the play button."
    }
  },
  "size": {
    "container": {
      "$type": "dimension",
      "$value": {
        "value": 1200,
        "unit": "px"
      },
      "$description": "Maximum content width of every section, header included."
    },
    "gutter": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Side padding on computer."
    },
    "gutter-mobile": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Side padding on phone."
    },
    "section-padding": {
      "$type": "dimension",
      "$value": {
        "value": 96,
        "unit": "px"
      },
      "$description": "Vertical padding of every section, computer."
    },
    "section-padding-mobile": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "Vertical padding of every section, phone."
    },
    "button-height": {
      "$type": "dimension",
      "$value": {
        "value": 52,
        "unit": "px"
      },
      "$description": "Every button."
    },
    "touch-target": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$description": "Minimum height of anything tappable."
    },
    "focus-ring": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "Keyboard focus outline: secondary colour on light areas, white on dark areas, 3 px offset."
    }
  }
}
